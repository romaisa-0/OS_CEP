import multiprocessing
import time

# Global variable for fruit count in the tree
total_fruits = 30

# Crate size (12 slots)
CRATE_SIZE = 12

# Tree class
class Tree:
    def __init__(self, fruits):
        self.fruits = fruits

    def pick_fruit(self):
        # Mimics picking fruit from the tree
        if self.fruits:
            return self.fruits.pop(0)
        return None

# Picker class (the workers)
class Picker(multiprocessing.Process):
    def __init__(self, tree, crate, loader, lock, picker_id):
        super().__init__()
        self.tree = tree
        self.crate = crate
        self.loader = loader
        self.lock = lock
        self.picker_id = picker_id

    def run(self):
        while True:
            fruit = self.tree.pick_fruit()
            if fruit is None:
                break  # Tree is empty
            
            with self.lock:
                # Adding fruit to the crate
                self.crate.append(fruit)
                print(f"Picker-{self.picker_id} picked fruit {fruit} and placed it in crate.")

                if len(self.crate) == CRATE_SIZE:
                    print(f"Picker-{self.picker_id} crate full. Calling loader...")
                    self.loader.load_crate(self.crate)
                    self.crate.clear()  # Empty the crate after loading
                    print(f"Picker-{self.picker_id} crate is now empty.")

        # If the tree is empty and there are fruits in the crate, pass them to the loader
        if self.crate:
            self.loader.load_crate(self.crate)
            print(f"Picker-{self.picker_id} loaded remaining fruits into the truck.")

# Loader class (responsible for loading the crate into the truck)
class Loader(multiprocessing.Process):
    def __init__(self, lock, truck):
        super().__init__()
        self.lock = lock
        self.truck = truck

    def load_crate(self, crate):
        with self.lock:
            print(f"Loader is loading a crate into the truck: {crate}")
            self.truck.append(crate)
            print("Loader has finished loading the crate.")

# Main function to simulate the entire process
def main():
    # Create a tree with fruits
    tree = Tree([i for i in range(1, total_fruits + 1)])

    # Shared resources
    crate = multiprocessing.Manager().list()  # Shared crate among pickers
    truck = multiprocessing.Manager().list()  # Shared truck for storing crates

    # Lock to ensure mutual exclusion
    lock = multiprocessing.Lock()

    # Create and start the loader process
    loader = Loader(lock, truck)
    loader.start()

    # Create and start picker processes (3 pickers)
    pickers = []
    for i in range(3):
        picker = Picker(tree, crate, loader, lock, i + 1)
        pickers.append(picker)
        picker.start()

    # Wait for all pickers to finish
    for picker in pickers:
        picker.join()

    # Ensure the loader finishes any remaining tasks
    loader.join()

    # Final output
    print("\nAll pickers have finished. Truck contains the following crates:")
    print(truck)

if __name__ == "__main__":
    main()
