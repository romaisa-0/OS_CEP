import threading
import time

# Shared resources
tree_fruits = [i for i in range(1, 31)]  # Global tree with 30 fruits
tree_lock = threading.Lock()

crate = []  # Shared crate with max 12 fruits
crate_lock = threading.Lock()
crate_full = threading.Condition(crate_lock)  # Notifies when crate is full
crate_empty = threading.Condition(crate_lock)  # Notifies when crate is emptied by loader

truck = []  # List of crates loaded into the truck
done_picking = threading.Event()  # Signal when all pickers are done

class Picker(threading.Thread):
    def __init__(self, picker_id):
        super().__init__()
        self.picker_id = picker_id

    def run(self):
        while True:
            with tree_lock:
                if tree_fruits:
                    fruit = tree_fruits.pop()
                    print(f"[Picker {self.picker_id}] Picked fruit {fruit}.")
                else:
                    break

            with crate_lock:
                while len(crate) == 12:
                    print(f"[Picker {self.picker_id}] Crate full, waiting for loader.")
                    crate_full.notify()  # Notify loader to load crate
                    crate_empty.wait()  # Wait for loader to empty crate

                crate.append(fruit)
                print(f"[Picker {self.picker_id}] Placed fruit {fruit} in crate. Crate size: {len(crate)}/12")

                if len(crate) == 12:
                    print(f"[Picker {self.picker_id}] Crate is now full. Notifying loader.")
                    crate_full.notify()

        print(f"[Picker {self.picker_id}] No more fruits to pick. Exiting.")

class Loader(threading.Thread):
    def run(self):
        while True:
            with crate_lock:
                while len(crate) < 12 and not done_picking.is_set():
                    crate_full.wait()  # Wait until crate is full or all pickers are done

                if len(crate) == 0 and done_picking.is_set():
                    break  # Exit if crate is empty and pickers are done

                if crate:
                    print("[Loader] Loading crate into truck...")
                    time.sleep(2)  # Simulate loading time
                    truck.append(crate.copy())
                    print(f"[Loader] Crate loaded: {crate}")
                    crate.clear()
                    crate_empty.notify_all()  # Notify all pickers that crate is empty

        # Final check for any partially filled crate
        with crate_lock:
            if crate:
                print("[Loader] Final partial crate detected. Loading it.")
                truck.append(crate.copy())
                crate.clear()

        print("[Loader] No more crates to load. Exiting.")

def main():
    loader = Loader()
    pickers = [Picker(i) for i in range(1, 4)]

    loader.start()
    for picker in pickers:
        picker.start()

    for picker in pickers:
        picker.join()

    # Signal loader that all pickers are done
    done_picking.set()
    with crate_lock:
        crate_full.notify_all()

    loader.join()

    print("\n=== Final Report ===")
    print(f"Crates loaded into truck: {len(truck)}")
    for i, c in enumerate(truck, 1):
        print(f"Crate {i}: {c}")
    print("====================")

if __name__ == "__main__":
    main()
