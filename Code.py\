import multiprocessing as mp
import time

# Shared tree of fruits
class Tree:
    def __init__(self, fruits):
        self.fruits = mp.Manager().list(fruits)
        self.lock = mp.Lock()

    def pick_fruit(self):
        with self.lock:
            if self.fruits:
                return self.fruits.pop(0)
            return None

# Crate shared by pickers
class Crate:
    def __init__(self):
        self.fruits = mp.Manager().list()
        self.lock = mp.Lock()

    def add_fruit(self, fruit):
        with self.lock:
            self.fruits.append(fruit)

    def is_full(self):
        with self.lock:
            return len(self.fruits) >= 12

    def get_and_clear(self):
        with self.lock:
            items = list(self.fruits)
            self.fruits[:] = []
            return items

    def is_empty(self):
        with self.lock:
            return len(self.fruits) == 0

# Picker process
def picker(pid, tree, crate, full_event, empty_event, log, picker_done, done_counter):
    while True:
        fruit = tree.pick_fruit()
        if fruit is None:
            break

        crate.add_fruit(fruit)
        log.put(f"[Picker-{pid}] Picked fruit: {fruit}")

        if crate.is_full():
            log.put(f"[Picker-{pid}] Crate full. Waiting for loader.")
            full_event.set()
            empty_event.wait()
            empty_event.clear()
            log.put(f"[Picker-{pid}] Resumed with empty crate.")

    log.put(f"[Picker-{pid}] Finished picking.")
    with done_counter.get_lock():
        done_counter.value += 1
    picker_done[pid] = True

# Loader process
def loader(crate, truck, full_event, empty_event, log, picker_done, done_counter, total_pickers):
    while True:
        full_event.wait()
        full_event.clear()

        fruits = crate.get_and_clear()
        truck.append(fruits)
        log.put(f"[Loader] Loaded crate into truck: {fruits}")
        empty_event.set()

        if done_counter.value == total_pickers:
            break

    # Handle final partial crate
    if not crate.is_empty():
        fruits = crate.get_and_clear()
        truck.append(fruits)
        log.put(f"[Loader] Loaded final partial crate: {fruits}")

    log.put("[Loader] Finished loading all crates.")

# Logger process
def logger(log):
    while True:
        msg = log.get()
        if msg == "DONE":
            break
        print(msg)

# Main function
def run_simulation():
    mp.set_start_method("spawn")
    fruits = list(range(1, 61))  # 60 fruits on tree
    tree = Tree(fruits)
    crate = Crate()
    manager = mp.Manager()
    truck = manager.list()

    full_event = mp.Event()
    empty_event = mp.Event()
    log = mp.Queue()
    done_counter = mp.Value('i', 0)
    total_pickers = 3
    picker_done = manager.dict({i: False for i in range(total_pickers)})

    pickers = [mp.Process(target=picker, args=(i, tree, crate, full_event, empty_event, log, picker_done, done_counter)) for i in range(total_pickers)]
    load_proc = mp.Process(target=loader, args=(crate, truck, full_event, empty_event, log, picker_done, done_counter, total_pickers))
    log_proc = mp.Process(target=logger, args=(log,))

    log_proc.start()
    load_proc.start()
    for p in pickers:
        p.start()
    for p in pickers:
        p.join()
    load_proc.join()

    log.put("DONE")
    log_proc.join()

    print("\n--- Simulation Summary ---")
    for i in range(len(truck)):
        print(f"Crate {i+1}: {truck[i]}")

if __name__ == "__main__":
    run_simulation()
