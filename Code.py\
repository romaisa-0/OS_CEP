from multiprocessing import Process, Semaphore, Value, Array, Lock, current_process
import time

CRATE_SIZE = 12  # Number of fruits per crate

def picker(tree, crate, crate_index, tree_index, full_crate_sem, crate_lock, done_pickers, done_lock):
    while True:
        with done_lock:
            if tree_index.value >= len(tree):
                break

        with crate_lock:
            if crate_index.value < CRATE_SIZE:
                with done_lock:
                    if tree_index.value < len(tree):
                        fruit = tree[tree_index.value]
                        tree_index.value += 1
                    else:
                        fruit = None

                if fruit is not None:
                    position = crate_index.value
                    crate[position] = fruit
                    crate_index.value += 1
                    print(f"[{current_process().name}] Placed fruit {fruit:>2} into crate slot {position + 1}/{CRATE_SIZE}")

                    if crate_index.value == CRATE_SIZE:
                        print(f"[{current_process().name}] Crate is full. Signaling loader...\n")
                        full_crate_sem.release()

    with done_lock:
        done_pickers.value += 1
        print(f"[{current_process().name}] Finished. ({done_pickers.value}/3 pickers complete)")

        # Ensure loader checks for partial crate
        if done_pickers.value == 3:
            full_crate_sem.release()


def loader(crate, crate_index, full_crate_sem, done_pickers, crate_lock, done_lock):
    crate_number = 0
    while True:
        full_crate_sem.acquire()

        with crate_lock:
            if crate_index.value > 0:
                crate_number += 1
                loaded = list(crate[:crate_index.value])
                print(f"[Loader] Loading crate {crate_number} with {crate_index.value} fruit(s): {loaded}\n")
                crate_index.value = 0

        with done_lock:
            if done_pickers.value == 3 and crate_index.value == 0:
                print("[Loader] All crates loaded. Exiting.\n")
                break


def main():
    try:
        total_fruits = int(input("Enter total number of fruits on the tree: ").strip())
        if total_fruits <= 0:
            print("Error: Please enter a positive integer.")
            return
    except ValueError:
        print("Error: Invalid input. Please enter a valid number.")
        return

    tree = list(range(1, total_fruits + 1))

    # Shared resources
    crate = Array('i', CRATE_SIZE)
    crate_index = Value('i', 0)
    tree_index = Value('i', 0)
    done_pickers = Value('i', 0)

    # Synchronization
    full_crate_sem = Semaphore(0)
    crate_lock = Lock()
    done_lock = Lock()

    # Create and start picker processes
    pickers = [
        Process(
            target=picker,
            name=f"Picker-{i+1}",
            args=(tree, crate, crate_index, tree_index, full_crate_sem, crate_lock, done_pickers, done_lock)
        ) for i in range(3)
    ]

    loader_proc = Process(
        target=loader,
        args=(crate, crate_index, full_crate_sem, done_pickers, crate_lock, done_lock)
    )

    for p in pickers:
        p.start()
    loader_proc.start()

    for p in pickers:
        p.join()
    loader_proc.join()

    print("\nAll operations completed successfully.")


if __name__ == "__main__":
    main()
